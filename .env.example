# Скопіюйте у .env: cp .env.example .env
# Значення за замовчуванням — для локальної розробки проти стенду platform (make up там).

PORT=3002
# /internal/v1/* (знімок для timetable-service) — окремий порт, шлюз на нього не веде.
INTERNAL_PORT=3102
LOG_LEVEL=info

# База school на сервері PostgreSQL зі стенду platform. Ролі й паролі створює platform/db-init
# (паролі — змінні SCHOOL_*_DB_PASSWORD у .env репозиторію platform).
# Робоча роль: лише DML, без BYPASSRLS.
DATABASE_URL=postgres://school_app:local-school-app-pass@localhost:5432/school
# Relay outbox → Kafka (другий пул у процесі): бачить лише outbox.
RELAY_DATABASE_URL=postgres://school_relay:local-school-relay-pass@localhost:5432/school
# Щоденна чистка журналу, outbox та inbox (третій пул).
MAINT_DATABASE_URL=postgres://school_maint:local-school-maint-pass@localhost:5432/school
# Власник таблиць — лише для make migrate.
MIGRATION_DATABASE_URL=postgres://school_owner:local-school-owner-pass@localhost:5432/school

# Перевірка JWT: iss — публічна адреса Keycloak (як у браузері), ключі — звідки сервіс їх може взяти.
OIDC_ISSUER=http://localhost/idp/realms/lad
OIDC_JWKS_URL=http://localhost/idp/realms/lad/protocol/openid-connect/certs

# Kafka зі стенду platform: з хоста — localhost:29092, з контейнера compose — kafka:9092.
# Порожнє значення вимикає relay і консюмер (лише HTTP).
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=school-service
KAFKA_GROUP_ID=school-service
